{
  "name": "skibidoo-storefront",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:docker": "astro build --config astro.config.docker.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.8",
    "@astrojs/node": "^10.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.6.0",
    "@testing-library/dom": "^10.4.1",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "secretlint": "^11.6.0",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "sh -c 'FILES=$(git diff --cached --name-only --diff-filter=ACMR); [ -z \"$FILES\" ] && exit 0; npx secretlint $FILES'"
  }
}
